{
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "expo:start": "set -a && . ./.env && set +a && expo start --clear --port $PORT",
    "expo:start:tunnel": "expo start --clear --tunnel",
    "expo:build": "expo export --platform web --output-dir build",
    "expo:serve": "set -a && . ./.env && set +a && expo serve build --port $PORT",
    "caddy:run": "caddy run --config Caddyfile --envfile .env",
    "caddy:trust": "caddy trust",
    "docker:build": "docker compose build --no-cache",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "ci:secrets": "set -a && . ./.env && set +a && gh secret set DOT_ENV < .env",
    "eas:init": "set -a && . ./.env && set +a && eas init",
    "eas": "set -a && . ./.env && set +a && eas workflow:run .eas/workflows/deploy.yml --non-interactive --wait"
  },
  "dependencies": {
    "babel-preset-expo": "~58.0.24",
    "expo": "^58.0.23",
    "expo-font": "~58.0.11",
    "expo-router": "~58.0.30",
    "expo-system-ui": "~58.0.7",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "dribbble-mcp": "^1.0.0",
    "eas-cli": "^27.6.0"
  }
}
