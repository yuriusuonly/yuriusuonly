{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      },
      "dribbble": {
        "type": "local",
        "command": [
          "node",
          "--env-file",
          ".env",
          "node_modules/dribbble-mcp/dist/index.js"
        ],
        "cwd": "."
      }
    }
  }
}
