{
	# Admin left ON (localhost:2019) so `caddy trust` can fetch the
	# local CA root. Disabling it breaks `npm run caddy:trust` with
	# "dial tcp [::1]:2019: connect: connection refused".
	# Disable the automatic HTTP→HTTPS redirect server (it binds :80,
	# which needs root). TLS is served on {$URL_PROXY_PORT} only.
	auto_https disable_redirects
	# Never install Caddy's local CA into the system trust store.
	# Service Workers require a trusted cert — trust the local CA via
	# `npm run caddy:trust` when needed.
	#skip_install_trust
}

https://localhost:{$URL_PROXY_PORT} {
	reverse_proxy {$BACKEND_HOST:localhost}:{$URL_PORT}
}
